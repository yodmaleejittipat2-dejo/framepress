rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Website content + presets: everyone can read, only the admin account can write.
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "jittipat_admin@framepress.app"
                   && docId in ["content", "presets"];
    }
    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
